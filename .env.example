# ========== DISTRINOV ENV VARIABLES ==========

# Server
NODE_ENV=development
PORT=3000

# Database (Railway fournira automatiquement DATABASE_URL en prod)
# Local dev : postgresql://distrinov:distrinov_dev@db:5432/distrinov
DATABASE_URL=postgresql://user:password@host:5432/distrinov

# CORS
CORS_ORIGIN=*

# Optional: Authentication / Security
# JWT_SECRET=your-secret-key-here
# BASIC_AUTH_PASSWORD=recruiter-password-here
